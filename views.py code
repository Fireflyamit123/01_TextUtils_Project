from django.shortcuts import render

def analyze(request):
    # Get text from the form (using POST as defined in the HTML form)
    djtext = request.POST.get('text', 'default')

    # Get toggle values ('on' or 'off')
    removepunc = request.POST.get('removepunc', 'off')
    fullcaps = request.POST.get('fullcaps', 'off')
    newlineremover = request.POST.get('newlineremover', 'off')
    extraspaceremover = request.POST.get('extraspaceremover', 'off')

    # Keep track of operations performed
    purpose = []

    # 1. Remove Punctuations
    if removepunc == "on":
        punctuations = '''!()-[]{};:'"\,<>./?@#$%^&*_~'''
        analyzed = ""
        for char in djtext:
            if char not in punctuations:
                analyzed += char
        purpose.append('Removed Punctuations')
        djtext = analyzed

    # 2. Convert to UPPERCASE
    if fullcaps == "on":
        analyzed = ""
        for char in djtext:
            analyzed += char.upper()
        purpose.append('Changed to Uppercase')
        djtext = analyzed

    # 3. New Line Remover
    if newlineremover == "on":
        analyzed = ""
        for char in djtext:
            if char != "\n" and char != "\r":
                analyzed += char
        purpose.append('Removed New Lines')
        djtext = analyzed

    # 4. Extra Spaces Remover
    if extraspaceremover == "on":
        analyzed = ""
        for index, char in enumerate(djtext):
            if not (djtext[index] == " " and index + 1 < len(djtext) and djtext[index + 1] == " "):
                analyzed += char
        purpose.append('Removed Extra Spaces')
        djtext = analyzed

    # If no options were selected
    if not purpose:
        purpose.append('No Operation Selected')

    params = {
        'purpose': ', '.join(purpose),
        'analyzed_text': djtext
    }

    return render(request, 'analyze.html', params)
